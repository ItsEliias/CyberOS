# CyberOS Ecosystem — ItsEliias
# Monorepo .gitignore — applies to all apps

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs (electron-vite)
out/
dist/
dist-electron/
release/
*.app
*.dmg
*.exe
*.deb
*.rpm
*.snap

# Environment
.env
.env.*
!.env.example
*.local

# Secrets / credentials — never commit these
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
secrets/
.aws/
.gnupg/
id_rsa
id_ed25519
*_rsa
*_ed25519
known_hosts
authorized_keys

# CyberOS-specific encrypted blobs (defensive — they shouldn't be in the
# repo anyway, but block accidental adds)
vault.enc
salt.bin
touch-id.enc
apikey.enc
htb-token.enc
thm-token.enc
backup-key.enc
*.cyberos-backup

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Electron packager
app-builds/

# Claude-flow / Ruflo coordinator scratch data — not source
.claude-flow/
**/.claude-flow/
