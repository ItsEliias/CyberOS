{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": false,
    "outDir": "out/main",
    "sourceMap": true,
    "types": ["node"],
    "composite": true,
    "skipLibCheck": true
  },
  "include": ["src/main/**/*.ts", "electron.vite.config.ts", "src/shared/**/*.ts"]
}
