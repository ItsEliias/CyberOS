{
  "compilerOptions": {
    "composite"        : true,
    "module"           : "ESNext",
    "moduleResolution" : "bundler",
    "target"           : "ESNext",
    "lib"              : ["ESNext"],
    "strict"           : true,
    "skipLibCheck"     : true,
    "resolveJsonModule": true,
    "outDir"           : "out"
  },
  "include": ["src/main/**/*", "src/shared/**/*", "electron.vite.config.ts"]
}
