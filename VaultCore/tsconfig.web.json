{
  "compilerOptions": {
    "composite"        : true,
    "module"           : "ESNext",
    "moduleResolution" : "bundler",
    "target"           : "ESNext",
    "lib"              : ["ESNext", "DOM", "DOM.Iterable"],
    "jsx"              : "react-jsx",
    "strict"           : true,
    "skipLibCheck"     : true,
    "resolveJsonModule": true,
    "paths"            : { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*"]
}
