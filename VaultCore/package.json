{
  "name": "vaultcore",
  "version": "1.0.0",
  "description": "Centralized vault intelligence engine — CYBERTOOLS",
  "main": "out/main/index.js",
  "scripts": {
    "sync-lib": "node -e \"const fs=require('fs'),path=require('path');const FILES=['launcher.js','ecosystem-bus.js','sourcelibrary.js','vaulthealth.js','conflict.js','processor.js','scraper.js'];const dest='out/main/lib';fs.mkdirSync(dest,{recursive:true});FILES.forEach(f=>{if(fs.existsSync(f))fs.copyFileSync(f,path.join(dest,f));});if(fs.existsSync('sources')){const walk=(s,d)=>{fs.mkdirSync(d,{recursive:true});for(const e of fs.readdirSync(s,{withFileTypes:true})){const sp=path.join(s,e.name),dp=path.join(d,e.name);e.isDirectory()?walk(sp,dp):fs.copyFileSync(sp,dp);}};walk('sources','out/main/lib/sources');}console.log('Synced backend JS to out/main/lib/');\"",
    "start": "npm run sync-lib && electron-vite dev",
    "build": "npm run sync-lib && electron-vite build && electron-builder",
    "build:mac": "npm run sync-lib && electron-vite build && electron-builder --mac",
    "build:win": "npm run sync-lib && electron-vite build && electron-builder --win",
    "build:linux": "npm run sync-lib && electron-vite build && electron-builder --linux",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@playwright/browser-chromium": "^1.40.0",
    "cheerio": "^1.0.0-rc.12",
    "cron-parser": "^4.9.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.40.0",
    "turndown": "^7.1.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "framer-motion": "^11.18.2",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "com.itsEliias.vaultcore",
    "productName": "VaultCore",
    "copyright": "Copyright © 2024 ItsEliias",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "!dist/**",
      "!src/**",
      "!.git/**",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/logo.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/logo.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/logo.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  },
  "author": {
    "name": "ItsEliias",
    "email": "ItsEliias@users.noreply.github.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "homepage": "https://github.com/ItsEliias/CyberOS"
}
